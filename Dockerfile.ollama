FROM debian:bookworm-slim
ARG TARGETARCH
RUN apt-get update -qq && apt-get install -y --no-install-recommends python3 ca-certificates libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY scripts/install_ollama_cpu.py /tmp/install_ollama_cpu.py
RUN python3 /tmp/install_ollama_cpu.py "$TARGETARCH" && rm /tmp/install_ollama_cpu.py
ENV OLLAMA_HOST=0.0.0.0:11434
ENTRYPOINT ["/usr/bin/ollama"]
CMD ["serve"]
