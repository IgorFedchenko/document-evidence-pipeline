# Local models only. No API keys required. First run downloads free model weights.
APP_PORT=8016
EXTRACTOR=ollama
OLLAMA_MODEL=qwen2.5:1.5b
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OCR_PROVIDER=tesseract
OCR_LANGUAGE=eng
# Optional access token: set before exposing beyond your own machine.
# The default Compose port binds to 127.0.0.1 only.
ACCESS_TOKEN=
# Textract is disabled. Owner approval of cost and host-installed AWS credentials required.
ALLOW_PAID_OCR=false
AWS_REGION=us-east-1
