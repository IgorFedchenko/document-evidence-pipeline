# Default scripts/start.sh forces recorded extraction, hash vectors and Tesseract.
# These ports belong to the recorded demo only.
APP_PORT=8017
VECTOR_PORT=8097
# Optional local workspace protection; never commit a real token.
ACCESS_TOKEN=

# Optional local-model stack (compose.local-models.yaml) only; not started by default.
# It needs initial model downloads and is outside recorded acceptance.
# APP_PORT=8016
OLLAMA_MODEL=qwen2.5:1.5b
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OCR_PROVIDER=tesseract
OCR_LANGUAGE=eng
ALLOW_PAID_OCR=false
